generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  client
}

enum ProductStatus {
  draft
  active
  archived
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum OrderStatus {
  new
  awaiting_payment
  paid
  confirmed
  processing
  packed
  shipped
  delivered
  cancelled
  returned
}

enum RepairStatus {
  new
  diagnostics
  in_progress
  ready
  completed
  cancelled
}

enum Condition {
  new
  used
  showroom
}

enum PrincipalType {
  employee
  customer
}

enum CustomerTier {
  standard
  studio
  vip
}

enum PaymentMethod {
  cash
  online
}

enum DeliveryMethod {
  pickup
  courier
  delivery_company
  post
}

enum DeliveryStatus {
  not_ready
  ready_for_shipment
  shipped
  in_transit
  delivered
  delivery_failed
  returned
}

enum PackagingStatus {
  not_started
  in_progress
  packed
}

enum InventoryMovementType {
  reserve
  release
  ship
  manual_adjustment
}

enum ActorType {
  system
  employee
  customer
}

model Employee {
  id           String    @id
  name         String
  login        String?   @unique
  email        String    @unique
  phone        String
  role         Role
  status       String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  packagingTasks PackagingDetail[]   @relation("PackagingEmployee")
  statusChanges  OrderStatusHistory[] @relation("OrderStatusChangedByEmployee")
}

model Customer {
  id           String       @id
  name         String
  fullName     String?
  phone        String
  email        String       @unique
  tier         CustomerTier
  status       String
  notes        String
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  orders       Order[]
  repairs      RepairRequest[]
}

model Session {
  id            String        @id
  principalType PrincipalType
  employeeId    String?
  customerId    String?
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  employee      Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Category {
  id          String     @id
  name        String
  slug        String     @unique
  parentId    String?
  image       String
  status      String
  description String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
}

model Product {
  id               String              @id
  name             String
  slug             String?             @unique
  sku              String              @unique
  barcode          String?
  categoryId       String
  brand            String
  price            Int
  costPrice        Int
  stockQty         Int
  reservedQty      Int                 @default(0)
  minStockQty      Int?
  status           ProductStatus
  shortDescription String
  description      String
  specs            Json
  images           String[]
  primaryImage     String?
  condition        Condition
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  category         Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryMoves   InventoryMovement[]
  orderItems       OrderItem[]

  @@index([status])
  @@index([categoryId])
  @@index([brand])
}

model InventoryMovement {
  id        String   @id
  productId String
  delta     Int
  type      InventoryMovementType @default(manual_adjustment)
  reason    String
  referenceType String?
  referenceId String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([createdAt])
}

model Order {
  id                    String               @id
  orderNumber           String               @unique
  customerId            String
  customerNameSnapshot  String
  phoneSnapshot         String
  emailSnapshot         String?
  deliveryAddressSnapshot String
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus
  deliveryMethod        DeliveryMethod
  status                OrderStatus
  notes                 String
  subtotal              Int                  @default(0)
  deliveryCost          Int                  @default(0)
  total                 Int                  @default(0)
  confirmedAt           DateTime?
  packedAt              DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  customer              Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  payments              Payment[]
  delivery              Delivery?
  packaging             PackagingDetail?
  statusHistory         OrderStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
}

model OrderItem {
  id          String  @id
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Int
  totalPrice  Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id             String        @id
  orderId        String
  method         PaymentMethod
  status         PaymentStatus
  amount         Int
  transactionId  String?
  provider       String?
  providerPayload Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Delivery {
  id             String         @id
  orderId        String         @unique
  method         DeliveryMethod
  company        String?
  address        String
  trackingNumber String?
  shippingCost   Int            @default(0)
  status         DeliveryStatus
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PackagingDetail {
  id           String          @id
  orderId      String          @unique
  status       PackagingStatus
  packedAt     DateTime?
  employeeId   String?
  weightGrams  Int?
  dimensions   String?
  fragile      Boolean         @default(false)
  packageType  String?
  comment      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employee     Employee?       @relation("PackagingEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
}

model OrderStatusHistory {
  id           String      @id
  orderId      String
  oldStatus    OrderStatus?
  newStatus    OrderStatus
  changedByType ActorType  @default(system)
  changedById   String?
  comment       String?
  changedAt     DateTime   @default(now())
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employee      Employee?  @relation("OrderStatusChangedByEmployee", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([changedAt])
}

model RepairRequest {
  id             String       @id
  customerId     String
  instrumentName String
  brand          String
  issue          String
  status         RepairStatus
  notes          String
  estimatedCost  Int?
  assignedMasterName String?
  receivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([status])
}

model Activity {
  id            String   @id
  title         String
  messageKey    String
  messageParams Json
  timestamp     DateTime @default(now())

  @@index([timestamp])
}

model BusinessSettings {
  id                   String        @id
  currency             String
  lowStockThreshold    Int
  defaultProductStatus ProductStatus
  defaultMarkupPercent Int
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}
